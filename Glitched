local function mkBox(plr)
    local b=Instance.new("Frame")
    b.Name="esp_"..plr.Name
    b.BackgroundTransparency=1
    b.BorderSizePixel=0
    b.Parent=espGui
    local s=Instance.new("UIStroke")
    s.Parent=b
    s.Thickness=1.5
    s.Color=Color3.fromRGB(255,60,60)
    s.Transparency=0.2
    local l=Instance.new("TextLabel")
    l.Parent=b
    l.BackgroundTransparency=1
    l.Text=plr.Name
    l.Font=Enum.Font.GothamBold
    l.TextSize=12
    l.TextColor3=Color3.fromRGB(255,255,255)
    l.TextStrokeTransparency=0
    l.AnchorPoint=Vector2.new(0.5,1)
    l.Position=UDim2.new(0.5,0,0,-2)
    l.Size=UDim2.new(0,120,0,14)
    espObjects[plr]={box=b}
end
local function rmBox(plr)
    local o=espObjects[plr]
    if o and o.box then o.box:Destroy() end
    espObjects[plr]=nil
end
for _,p in ipairs(Players:GetPlayers()) do if p~=LP then mkBox(p) end end
Players.PlayerAdded:Connect(function(p) if p~=LP then mkBox(p) end end)
Players.PlayerRemoving:Connect(rmBox)
RS.RenderStepped:Connect(function()
    for plr,o in pairs(espObjects) do
        if o.box then
            if not S.espOn then
                o.box.Visible=false
            else
                o.box.Visible=true
                local ch=plr.Character
                if ch then
                    local hrp=ch:FindFirstChild("HumanoidRootPart")
                    local hd=ch:FindFirstChild("Head")
                    if hrp and hd then
                        local tS,tO=Cam:WorldToViewportPoint(hd.Position+Vector3.new(0,0.5,0))
                        local bS,bO=Cam:WorldToViewportPoint(hrp.Position-Vector3.new(0,3,0))
                        if tO and bO then
                            local hh=math.abs(tS.Y-bS.Y)
                            local ww=hh*0.45
                            o.box.Size=UDim2.new(0,ww,0,hh)
                            o.box.Position=UDim2.new(0,tS.X-ww/2,0,tS.Y)
                        end
                    end
                end
            end
        end
    end
end)

