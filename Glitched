local function loadOriginalFly()
    if S.flyLoaded=="original" then notif("Glitched Hub","already loaded") return end
    notif("Glitched Hub","loading original fly...")
    local ok,err=pcall(function()
        local src=game:HttpGet("https://raw.githubusercontent.com/XNEOFF/FlyGuiV3/main/FlyGuiV3.txt")
        src=src:gsub("Made by [Xx][Nn][Ee][Oo]","Made by Warrior")
        src=src:gsub("[Xx][Nn][Ee][Oo]FF","Warrior")
        src=src:gsub("[Xx][Nn][Ee][Oo]","Warrior")
        local fn=loadstring(src)
        if not fn then error("nil fn") end
        fn()
    end)
    if ok then S.flyLoaded="original" notif("Glitched Hub","original fly loaded")
    else notif("Glitched Hub","original fly failed") warn(err) end
end
