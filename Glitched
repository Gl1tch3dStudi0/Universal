    sk.MoonAngularSize=cfg.moon or 21
    sk.StarCount=cfg.stars or 3000
    sk.Parent=Lighting
    currentSky=sk
    Lighting.Ambient=cfg.ambient or Color3.fromRGB(70,70,70)
    Lighting.OutdoorAmbient=cfg.outdoor or Color3.fromRGB(128,128,128)
    Lighting.Brightness=cfg.bright or 1
